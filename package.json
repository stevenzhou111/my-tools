{
  "name": "vue-toolbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788 -- npm run dev",
    "build": "vite build && node scripts/gen-sitemap.mjs",
    "preview": "vite preview",
    "deploy": "vite build && wrangler pages deploy dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {

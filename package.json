    "dompurify": "^3.2.4",
    "echarts": "^6.1.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "js-yaml": "^5.4.2",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinyin-pro": "^3.29.5",
    "qrcode": "^1.5.4",
    "sm-crypto": "^0.5.7",
    "spark-md5": "^3.0.2",
    "sql-formatter": "^15.9.0",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.5.13",
    "vue-router": "^5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
